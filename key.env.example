# Copia a key.env (mismo archivo que Portal-Paldaca/key.env para SSO local).

DJANGO_SECRET_KEY=genera-una-clave-segura

SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_NAME=paldaca_sessionid
PALDACA_SSO_LOGIN_URL=http://localhost:5173/login/
PALDACA_SSO_LOGOUT_URL=http://localhost:8000/api/auth/sso/logout/

# Coolify / Docker: si existe, tiene prioridad sobre MYSQL_*.
DATABASE_URL=mysql://usuario:clave@host-interno-coolify:3306/default

# Local: solo si DATABASE_URL está vacío.
MYSQL_DB=paldaca_db
MYSQL_USER=RAG
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Origen absoluto que se imprime DENTRO de los QR de las etiquetas de activos.
# Debe ser el subdominio de este satélite, nunca la ruta dentro del shell del
# Portal: la etiqueta se pega al equipo una vez y tiene que resolver aunque se
# escanee sin sesión y sin pasar por cpaldaca.com.
# Cambiar este valor NO reescribe las etiquetas ya impresas.
PALDACA_PUBLIC_BASE_URL=https://activos.cpaldaca.com
