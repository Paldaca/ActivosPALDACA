# Coolify / Docker. No commitear valores reales.

# Obligatorio. Misma MySQL compartida que el Portal (no una db "activos" aparte).
DATABASE_URL=mysql://usuario:clave@host:3306/paldaca
DJANGO_SECRET_KEY=cambia-esta-clave

# Django
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=activos.cpaldaca.com,www.activos.cpaldaca.com
CSRF_TRUSTED_ORIGINS=https://activos.cpaldaca.com,https://www.activos.cpaldaca.com,https://cpaldaca.com,https://www.cpaldaca.com
SESSION_COOKIE_DOMAIN=.cpaldaca.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=paldaca_sessionid

# Portal PALDACA (misma DJANGO_SECRET_KEY que el Portal para SSO)
PALDACA_SSO_LOGIN_URL=https://cpaldaca.com/login
PALDACA_SSO_LOGOUT_URL=https://cpaldaca.com/api/auth/sso/logout/
PALDACA_PORTAL_URL=https://cpaldaca.com
PALDACA_SHELL_PATH=/activos

# Contenedor
PORT=8082
GUNICORN_WORKERS=3
DJANGO_LOG_TO_STDOUT=true
DATABASE_SSL_REQUIRE=false
